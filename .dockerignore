# Dependencies (never copy host node_modules into image)
**/node_modules
**/.pnpm-store
.pnpm-store

# Build outputs & caches (rebuilt inside the container)
**/dist
**/build
**/out
**/.next
**/.nuxt
**/.svelte-kit
**/.turbo
**/.cache
**/*.tsbuildinfo
**/coverage

# Git & version control
.git
.gitignore
.gitattributes

# Environment & secrets (keep .env.example, drop real envs)
**/.env
**/.env.*
!**/.env.example

# Logs & local data
**/*.log
npm-debug.log*
pnpm-debug.log*
**/data
**/*.sqlite
**/*.db

# Local docs (incl. the file you just untracked)
ProjectDetails.md
**/*.md
!README.md

# Docker & CI metadata (not needed inside the image)
Dockerfile*
docker-compose*.yml
.dockerignore
.github
.vscode
.idea
.DS_Store
Thumbs.db